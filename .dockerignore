# Контекст сборки: дек, записи, окружение и результаты в образ не идут.
Lib/
Include/
# `Scripts/` (venv под Windows) здесь писать нельзя: на регистронезависимой
# файловой системе тем же паттерном исключается наш scripts/, и сборка падает
# на `COPY scripts`. Артефакты venv перечислены поимённо.
Scripts/*.exe
Scripts/activate*
.venv/
.git/
.idea/
.pytest_cache/
.ruff_cache/
__pycache__/
runs/
vendor/Model_Z/
vendor/Model_Z_OPM/
# Открытые деки для проверки переносимости: гигабайты чужих данных, в образе
# не нужны вовсе (docs/portability.md).
vendor/portability/
*.webm
*.zip
*.pptx
*.pdf
docs/method/transcripts/
data/
data.7z
artifacts/
