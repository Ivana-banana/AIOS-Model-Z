# --- виртуальное окружение ---
# Живёт в `.venv/` и только там. Раньше оно лежало прямо в корне, и это стоило
# дорого: под Windows каталог venv называется `Scripts/`, а файловая система
# считает его тем же путём, что и наш `scripts/`. Правило `/Scripts/` тогда молча
# выкинуло из репозитория все скрипты запуска — до 16.08 каталога не было в
# истории вовсе, хотя на него ссылались README, Dockerfile и обе инструкции.
# Обратная сторона того же совпадения: `import scripts.*` регистрозависим, и
# тесты на такой машине шли только с `PYTHONCASEOK=1`, то есть не так, как у
# проверяющего. 23.08 окружение перенесено в `.venv/`, и обе беды исчезли вместе
# с причиной.
#
# В корне venv больше не создаём. Если он там появится, его артефакты будут
# видны в `git status` как неотслеживаемые — это громко и правильно; правил,
# прячущих их, здесь намеренно нет.
.venv/
/Lib/
/Include/
/pyvenv.cfg
/CACHEDIR.TAG

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
/pytest-temp-*/
.ruff_cache/
.ipynb_checkpoints/

# --- учётные данные ---
# Ключ API читается только из окружения (`aios/explain.py`, `anthropic.Anthropic()`),
# в `config.toml` его нет и быть не должно. Файла `.env` в проекте нет и ни один
# модуль его не читает — но заводится он руками за минуту и уезжает в коммит так
# же быстро, поэтому правило стоит до того, как файл появился, а не после.
.env
.env.*

# --- IDE ---
.idea/
.vscode/

# --- материалы организаторов ---
# Архивы, презентации и методики лежат в materials/ и коммитятся: 47 МБ на всю
# команду дешевле, чем каждому искать их по каналу.
# Записи встреч — нет: 458, 526 и 801 МБ при жёстком пределе GitHub 100 МБ на файл.
# Их содержимое живёт в docs/method/transcripts/, ссылки — в docs/materials.md.
*.webm
# Аудиозаписи контрольных точек — тоже нет. Расшифровки живут в docs/
# (например, docs/kt2-feedback-2026-08-31.md), сам звук остаётся локальным.
*.aac
*.m4a
*.mp3

# Распакованные деки: в materials/ лежат исходные архивы, распаковка локальная.
/vendor/Model_Z/
/vendor/Model_Z_OPM/
/data/raw/
# Чужие открытые деки для проверки переносимости входного контроля (Б20):
# клонируются командой из docs/portability.md, в наш репозиторий не едут —
# это чужие мегабайты и чужая лицензия (ODbL/DBCL).
/vendor/portability/

# --- результаты прогонов и веса ---
/runs/
/artifacts/

# Исключение из правила выше: **сдаваемый файл и машинный след его расчёта**.
#
# Всё остальное в `runs/` — гигабайты промежуточных прогонов, их место не в
# git. Но `wells_schedule.inc` заявки и `npv.json` рядом с ним — это и есть
# результат, который отправляют организаторам: тег `submit-*` их называет,
# `docs/submission.md` печатает их `md5`, а в репозитории их не было вовсе.
# Потеря диска означала бы потерю заявки, а чистый клон не содержал бы того,
# что мы сдаём (Р-181). Полтора мегабайта текста — приемлемая цена; правило
# «крупные бинарники не кладём» этим не нарушено.
!/runs/
/runs/*
!/runs/matched-0995/
/runs/matched-0995/*
!/runs/matched-0995/wells_schedule.inc
!/runs/matched-0995/npv.json
# 08.09 форма сдачи сменилась на «хвост» за период управления: заявляемым стал
# файл уровнем глубже, `submission/wells_schedule.inc`. Исключение выше на него
# не распространяется, и в git остался лежать прежний файл с другим `md5` —
# то есть тег `submit-2026-09-08` называл файл, которого в теге нет, а на клоне
# проверяющего `check_package.py` отвечал «пакет неполон» и возвращал 1.
# Сторож, который поймал бы это сам, — `test_packaging.py`,
# `test_the_file_the_submission_declares_is_tracked_by_git` (Н-03).
!/runs/matched-0995/submission/
/runs/matched-0995/submission/*
!/runs/matched-0995/submission/wells_schedule.inc
!/runs/matched-0995/submission/npv.json

# Полторы тысячи байт к тому же исключению: **след базового сценария**.
# Заявка — это тройка (заявленное, базовое, прирост), а машинный след был только
# у первого числа. Ранжирует нас именно прирост, и до 05.09 обе его половины,
# кроме верхней, держались на числах, вписанных в документы руками (Р-234).
# `rows.csv` базы по-прежнему не отслеживается — 5 МБ; след её пересчёта весит
# килобайт и делает прирост проверяемым на чистом клоне.
!/runs/base/
/runs/base/*
!/runs/base/npv.json

# Второе исключение: **кэш демо-объяснений**. По ТЗ п. 3.1 языковая модель — в
# ядре слоя интерпретируемости, но на клоне проверяющего нет ни ключа, ни сети,
# и слой отвечает шаблоном. `explain()` читает кэш **раньше**, чем проверяет
# `enabled` — значит, закоммиченный кэш показывает настоящий ответ модели с
# подписью «из кэша», без ключа и без вызова. Файл кэша пишется только на пути
# `llm`, уже после проверки чисел, поэтому подделать его шаблоном нельзя; что
# он и вправду от модели, стережёт тест (Е4).
!/artifacts/
/artifacts/*
!/artifacts/explanations/

# И третье: **обученный суррогат**. `docs/submission.md` называет его в комплекте
# поставки и печатает его `sha256`, а `scripts/check_package.py` требует файл
# пунктом 9 — то есть на любом чистом клоне, включая клон проверяющего, допуск
# падал 9 из 10 по отсутствию того, что мы сами и сдаём. 5,4 МБ — цена того,
# чтобы пакет собирался у того, кто его проверяет (Д4, Р-197).
!/artifacts/surrogate.joblib

# И четвёртое: **паспорт шлюза доверия**, 9 КБ. README называет шлюз в разделе
# про суррогат, а интерфейс печатает его меру на главной странице — но собрать
# паспорт можно было только из пакетов DoE, а они в git не ведутся. На клоне
# проверяющего страница честно отвечала «доверенная область не собрана», и
# главный аргумент решения — «кандидат вне области уходит на полный расчёт» —
# был не виден. Паспорт собирается из самого артефакта одной командой
# (`scripts/trust_gate.py --model artifacts/surrogate.joblib --pairs
# docs/data/margin-pairs-search.csv`), и он в git (Р-265).
!/artifacts/trust-gate.json
*.UNSMRY
*.UNRST
*.SMSPEC
*.EGRID
*.INIT
*.RSM
*.DBG
*.PRT
*.ckpt
*.pt
*.pth
*.onnx

# --- временное ---
*.log
~$*
.DS_Store

# Замок планировщика задач Claude Code: в нём id сессии и pid, он меняется при
# каждом запуске на каждой машине. В репозитории лежит с 16.08 по недосмотру и
# только плодит конфликты между А и Б.
.claude/scheduled_tasks.lock

# --- служебное автономной сессии (AFK) ---
.afk/
.afk-critic-*.md

# Датасеты прогонов: воспроизводятся из runs/ командой scripts/build_dataset.py
/data/
# Архив тех же датасетов для передачи на соседнюю машину (48 МБ): едет мимо git,
# отпечатки для сверки — в docs/handoff-datasets-2026-08-21.md. Правило добавили
# после того, как файл уже был закоммичен, поэтому оно не действовало до 01.09,
# когда архив сняли с отслеживания (п. 8.3 ТЗ, Р-131).
/data.7z
# Служебная передача между машинами А и Б (3,4 МБ): та же история, тот же путь —
# файл едет архивом мимо git, отпечатки в HANDOFF.md.
/to-machine-b.7z
